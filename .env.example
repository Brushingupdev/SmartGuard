# ─────────────────────────────────────────────────────────────
# SmartGuard — Variables de entorno
# Copiar a .env.local y completar con tus valores
# ─────────────────────────────────────────────────────────────

# ── Supabase (requerido) ─────────────────────────────────────
# Obtener en: https://supabase.com/dashboard → Project Settings → API

# URL pública del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Anon key (segura para client-side, protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (SOLO server-side, bypass RLS — NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Upstash Redis (requerido para rate limiting) ─────────────
# Obtener en: https://console.upstash.com

UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# ── Resend (requerido para alertas por email) ────────────────
# Obtener en: https://resend.com/api-keys

RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=SmartGuard <alerts@tu-dominio.com>

# ── Sentry (opcional, para error tracking) ───────────────────
# Obtener en: https://sentry.io → Project Settings → Client Keys

SENTRY_DSN=https://xxx@sentry.io/xxx

# ── Supabase Webhook Secret (opcional, para webhooks) ────────
# Configurar en: Supabase Dashboard → Authentication → Webhooks

SUPABASE_WEBHOOK_SECRET=tu_webhook_secret_aqui

# ── Seguridad y cron ──────────────────────────────────────────

CRON_SECRET=secret_para_endpoints_de_cron
IMPERSONATE_COOKIE_SECRET=secret_para_firmar_impersonacion
PUBLIC_CITA_TOKEN_SECRET=secret_para_links_publicos_de_citas

# Compatibilidad temporal: solo usar en transición si ya existen links antiguos
# sin firma que todavía deben seguir funcionando.
# ALLOW_LEGACY_PUBLIC_CITA_TOKENS=true

# ── Push Web Notifications ────────────────────────────────────

VAPID_PUBLIC_KEY=BK...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=alerts@tu-dominio.com

# ── WhatsApp / Green API (opcional) ───────────────────────────

GREEN_API_INSTANCE=1234567890
GREEN_API_TOKEN=token_de_green_api
GREEN_API_SERVER=7107

# ── Opcional ─────────────────────────────────────────────────

# URL base pública para links en emails, PWA y portal de citas
NEXT_PUBLIC_SITE_URL=https://smartguard.io
